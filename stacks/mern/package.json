{
  "name": "mern-challenges",
  "private": true,
  "type": "module",
  "scripts": {
    "challenge": "tsx scripts/select-challenge.ts",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "dev": "concurrently -n server,client -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "db:reset": "tsx db/reset.ts",
    "db:seed": "tsx db/seed.ts",
    "db:prepare": "pnpm db:reset && pnpm db:seed",
    "test:challenge": "cross-env CHALLENGE_VARIANT=exercise vitest run",
    "test:challenge:watch": "cross-env CHALLENGE_VARIANT=exercise vitest --watch",
    "test:solution": "cross-env CHALLENGE_VARIANT=reference vitest run",
    "build": "vite build --config vite.config.ts && tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "mongodb": "^6.18.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
