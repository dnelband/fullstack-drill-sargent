# Homebrew / macOS: use your OS username (no password with peer/trust auth), e.g.:
#   DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/practice_fullstack
# Linux Docker / classic installs often use:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/practice_fullstack
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/practice_fullstack
PORT=4010
VITE_API_BASE_URL=http://localhost:4010
